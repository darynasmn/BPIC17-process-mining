# v02: v01 + new offers after W_Call after offers or W_Call incomplete files (option C):
#   the first offer block always leads to W_Call after offers; later offers go through a separate
#   offer block (O_Create Offer @2, O_Sent @2, same loops) and then directly to validation / outcome.
# --- application ---
start -> A_Create Application
A_Create Application -> xor_sub
xor_sub -> A_Submitted
xor_sub -> xor_sub_j
A_Submitted -> xor_hl
xor_hl -> W_Handle leads
xor_hl -> xor_hl_j
W_Handle leads -> xor_hl_j
xor_hl_j -> xor_sub_j
xor_sub_j -> W_Complete application
# --- offer block: *(O_Create Offer) then *(O_Sent), as in v00/v01 ---
W_Complete application -> xor_co_in
xor_co_in -> O_Create Offer
O_Create Offer -> xor_co_again
xor_co_again -> xor_co_in
xor_co_again -> xor_se_in
xor_se_in -> O_Sent
O_Sent -> xor_se_again
xor_se_again -> xor_se_in
xor_se_again -> xor_offer_out
xor_offer_out -> W_Call after offers
W_Call after offers -> xor_cao_out
xor_cao_out -> xor_lo_in
xor_cao_out -> xor_val_entry
# --- validation block (v01) with the bypass of v00 ---
xor_val_entry -> xor_bypass
xor_bypass -> xor_va_in
xor_bypass -> xor_outcome_entry
xor_va_in -> W_Validate application
W_Validate application -> xor_ret
xor_ret -> O_Returned
xor_ret -> xor_ret_j
O_Returned -> xor_ret_j
xor_ret_j -> xor_after_va
xor_after_va -> W_Call incomplete files
xor_after_va -> xor_outcome_entry
W_Call incomplete files -> xor_after_cif
xor_after_cif -> xor_va_in
xor_after_cif -> xor_outcome_entry
xor_after_cif -> xor_lo_in
# --- outcome (v00) ---
xor_outcome_entry -> xor_out
xor_out -> A_Cancelled
xor_out -> O_Accepted
O_Accepted -> A_Pending
A_Cancelled -> xor_out_j
A_Pending -> xor_out_j
xor_out_j -> xor_oc
xor_oc -> xor_oc_in
xor_oc -> xor_oc_j
xor_oc_in -> O_Cancelled
O_Cancelled -> xor_oc_again
xor_oc_again -> xor_oc_in
xor_oc_again -> xor_oc_j
xor_oc_j -> xor_den
xor_den -> A_Denied
xor_den -> xor_den_j
A_Denied -> xor_ref_in
xor_ref_in -> O_Refused
O_Refused -> xor_ref_again
xor_ref_again -> xor_ref_in
xor_ref_again -> xor_den_j
xor_den_j -> end
# later offers (after W_Call after offers / W_Call incomplete files): separate block, then validation/outcome
xor_lo_in -> O_Create Offer @2
O_Create Offer @2 -> xor_lco_again
xor_lco_again -> xor_lo_in
xor_lco_again -> xor_lse_in
xor_lse_in -> O_Sent @2
O_Sent @2 -> xor_lse_again
xor_lse_again -> xor_lse_in
xor_lse_again -> xor_val_entry
